{
    "name": "studio255/yii2-fileupload",
    "description": "FilePond-based file upload widget for Yii2 — chunked uploads, ActiveRecord binding and image variants.",
    "type": "yii2-extension",
    "keywords": ["yii2", "yii2-extension", "filepond", "upload", "file-upload", "widget"],
    "license": "MIT",
    "homepage": "https://github.com/studio255/yii2-fileupload",
    "authors": [
        {
            "name": "Studio255 Karlsruhe",
            "email": "mail@studio255.de"
        }
    ],
    "support": {
        "issues": "https://github.com/studio255/yii2-fileupload/issues",
        "source": "https://github.com/studio255/yii2-fileupload"
    },
    "require": {
        "php": ">=8.2",
        "yiisoft/yii2": "~2.0.51",
        "npm-asset/filepond": "^4.20"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "autoload": {
        "psr-4": {
            "studio255\\fileupload\\": ""
        }
    }
}